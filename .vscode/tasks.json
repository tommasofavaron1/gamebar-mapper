{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build widget Release",
			"type": "process",
			"command": "${workspaceFolder}\\build.cmd",
			"problemMatcher": "$msCompile",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Install widget development package",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\install-dev.ps1"
			],
			"dependsOn": "Build widget Release",
			"problemMatcher": []
		},
		{
			"label": "Build backend Debug",
			"type": "process",
			"command": "dotnet",
			"args": [
				"build",
				"${workspaceFolder}\\companion\\ControllerMapper.Backend.csproj",
				"-c",
				"Debug",
				"-r",
				"win-x64"
			],
			"problemMatcher": "$msCompile",
			"group": "build"
		},
		{
			"label": "Run backend Debug",
			"type": "process",
			"command": "${workspaceFolder}\\companion\\bin\\Debug\\net9.0-windows\\win-x64\\ControllerMapper.Backend.exe",
			"args": [
				"--debug"
			],
			"dependsOn": "Build backend Debug",
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
			"label": "Test backend",
			"type": "process",
			"command": "${workspaceFolder}\\companion\\bin\\Debug\\net9.0-windows\\win-x64\\ControllerMapper.Backend.exe",
			"args": [
				"--self-test"
			],
			"dependsOn": "Build backend Debug",
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
			"label": "Configure HidHide",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\configure-hidhide.ps1"
			],
			"problemMatcher": []
		},
		{
			"label": "Build installer",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\installer\\build-installer.ps1"
			],
			"problemMatcher": "$msCompile",
			"group": "build"
		},
		{
			"label": "Open Xbox Game Bar",
			"type": "process",
			"command": "explorer.exe",
			"args": [
				"ms-gamebar:"
			],
			"problemMatcher": []
		}
	]
}