<Page
    x:Name="Root"
    x:Class="WidgetSampleCS.Widget1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WidgetSampleCS"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    XYFocusKeyboardNavigation="Enabled"
    mc:Ignorable="d">

    <Grid Background="#17191D" Padding="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontFamily="Segoe UI Semibold" FontSize="20" Text="Controller Mapper" />
                <TextBlock x:Name="ControllerStatus" Foreground="#A9AFB8" Text="Ricerca controller..." />
                <ComboBox x:Name="ControllerSelector"
                          Width="190"
                          Margin="0,10,0,0"
                          HorizontalAlignment="Left"
                          Header="Controller principale"
                          ItemsSource="{x:Bind ControllerOptions}"
                          SelectionChanged="ControllerSelector_SelectionChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ToggleSwitch x:Name="PreviewToggle"
                              Margin="0,0,14,0"
                              Header="Anteprima"
                              OffContent="Off"
                              OnContent="On"
                              Toggled="PreviewToggle_Toggled" />
                <ToggleSwitch x:Name="RemapToggle"
                              Header="Rimappatura"
                              OffContent="Off"
                              OnContent="On"
                              Toggled="RemapToggle_Toggled" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,14,0,10" Padding="12,9" Background="#24272D" CornerRadius="4">
            <TextBlock x:Name="PressedButtons" Foreground="#5FE0A3" Text="Nessun tasto premuto" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <TextBlock FontFamily="Segoe UI Semibold" Text="Ingresso" />
            <TextBlock Grid.Column="1" FontFamily="Segoe UI Semibold" Text="Uscita" />
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind Profile.Mappings, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="42">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="{Binding Source}" />
                            <ComboBox Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding TargetOptions}"
                                      SelectedItem="{Binding Target, Mode=TwoWay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="BackendStatus"
                       VerticalAlignment="Center"
                       Foreground="#F5C86B"
                       Text="Backend in attesa"
                       TextWrapping="Wrap" />
            <Button Grid.Column="1" Margin="12,0,0,0" Click="SaveButton_Click" Content="Salva profilo" />
        </Grid>
    </Grid>
</Page>
